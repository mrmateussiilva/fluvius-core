COMPOSE_PROJECT_NAME=fluvius-core-prod
APP_DOMAIN=fluvius.finderbit.com.br
ACME_EMAIL=admin@finderbit.com.br
FLUVIUS_DATA_DIR=/srv/fluvius

POSTGRES_DB=fluvius
POSTGRES_USER=fluvius
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
REDIS_PASSWORD=replace-with-an-independent-url-safe-random-password

SECRET_KEY=replace-jwt-with-at-least-32-random-characters
PROVIDER_CREDENTIALS_KEY=replace-provider-vault-with-a-different-random-secret
WEBHOOK_SECRET=replace-webhook-with-another-independent-random-secret
EVOLUTION_GO_GLOBAL_API_KEY=replace-evolution-admin-with-its-own-random-secret

# Apenas para canais legados. Novos canais recebem credencial pelo provisionamento.
EVOLUTION_GO_API_KEY=
EVOLUTION_GO_INSTANCE_TOKENS={}
EVOLUTION_OPERATOR_EMAIL=

# Referência fixada e imagem derivada com suporte às edições criptografadas.
EVOLUTION_GO_SOURCE_REF=9337afc47e10b86cc896a6f432240e40fee95dd1
EVOLUTION_GO_IMAGE=fluvius/evolution-go:0.7.2-edit-fix.1
