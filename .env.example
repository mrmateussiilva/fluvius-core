POSTGRES_DB=fluvius
POSTGRES_USER=fluvius
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
REDIS_PORT=6379
DELIVERY_WORKER_PROCESSES=2
API_PORT=8000
WEB_PORT=5173
EVOLUTION_GO_PORT=8080
ENVIRONMENT=development
AUTH_COOKIE_SECURE=false
LOGIN_RATE_LIMIT_ENABLED=false
EVOLUTION_GO_IMAGE=fluvius/evolution-go:0.7.2-edit-fix.1
EVOLUTION_GO_SOURCE_REF=9337afc47e10b86cc896a6f432240e40fee95dd1
# DNS externo usado pelos containers que acessam providers.
DOCKER_DNS_PRIMARY=1.1.1.1
DOCKER_DNS_SECONDARY=8.8.8.8

SECRET_KEY=generate-a-long-random-secret
PROVIDER_CREDENTIALS_KEY=generate-an-independent-long-random-secret
WEBHOOK_SECRET=generate-a-webhook-secret
EVOLUTION_GO_GLOBAL_API_KEY=generate-an-evolution-admin-key
# Token da instância retornado/criado pelo Evolution Go 0.7.2.
EVOLUTION_GO_API_KEY=replace-with-the-instance-token
# Para múltiplas instâncias, use um mapa JSON nome -> token e deixe a chave
# anterior apenas como fallback de instância única.
EVOLUTION_GO_INSTANCE_TOKENS={}
# URL pela qual o container Evolution Go alcança a API do Fluvius.
EVOLUTION_GO_WEBHOOK_BASE_URL=http://api:8000
EVOLUTION_OPERATOR_EMAIL=
